DATABASE_URL=postgres://agentcore_runtime:agentcore_runtime@localhost:5433/agentcore
MIGRATOR_DATABASE_URL=postgres://agentcore:agentcore@localhost:5433/agentcore
TEST_DATABASE_URL=postgres://agentcore:agentcore@localhost:5433/agentcore_test
TEST_RUNTIME_DATABASE_URL=postgres://agentcore_runtime:agentcore_runtime@localhost:5433/agentcore_test
# Optional. Empty: the service creates master.key in AGENT_CORE_DATA_DIR (openssl rand -base64 32 for your own).
AGENT_CORE_MASTER_KEY=
# Optional. Empty: the service generates an admin key on first start and prints it once.
AGENT_CORE_ADMIN_KEY=
# Optional. Where master.key lives.
# AGENT_CORE_DATA_DIR=./.data
# Optional. Without LLM_BASE_URL and LLM_MODEL_DEFAULT the service starts but refuses runs.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_DEFAULT=
SMOKE_MODEL=
PORT=7300
